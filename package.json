{
  "name": "secure-term",
  "version": "2.1.0",
  "description": "Encrypt a secret so you can send it through any channel. AES-256-GCM, no server, no dependencies. Works in the browser and the terminal.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://hfconsultant.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HFConsultant/HFConsultant.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/HFConsultant/HFConsultant.github.io/issues"
  },
  "keywords": [
    "encryption",
    "aes-gcm",
    "pbkdf2",
    "dotenv",
    "secrets",
    "cli",
    "webcrypto",
    "zero-dependency"
  ],
  "bin": {
    "secure-term": "cli/secure-term.js"
  },
  "exports": {
    ".": "./js/crypto.js",
    "./envfile": "./js/envfile.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "//": "The website is deliberately excluded from the published package: npm gets the shared core and the CLI, GitHub Pages serves the rest.",
  "files": [
    "cli/",
    "js/crypto.js",
    "js/envfile.js",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
